<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans 
       http://www.springframework.org/schema/beans/spring-beans.xsd">

   <bean id="greet" class="mypack.GreetingMsg">
       <property name="msg" value="Hello Java!"></property>
   </bean>
   <bean id="personInfo" class="mypack.Person">
   <constructor-arg type="String" index="0" value="Ruturaj"></constructor-arg>
    <constructor-arg type="String" index="1" value="Kolhapur"></constructor-arg>
     <constructor-arg  index="2" value="21"></constructor-arg>
   </bean>
</beans>
